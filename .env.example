# Database (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notebooklm
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# AWS / Storage (Local Floci or AWS S3 in Production)
AWS_REGION=us-east-1
AWS_S3_BUCKET=notebooklm-sources
# Set empty in production ECS to use real AWS S3; keep http://localhost:4566 for local Floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Security / AWS Cognito SSO
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example

# LLM Provider (OpenAI Compatible - Bedrock / OpenRouter / OpenAI)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
